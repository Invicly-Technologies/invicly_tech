# Copy to .env.local for local development. In production these are set in Vercel
# (Project → Settings → Environment Variables, for Production and Preview).

# ---- Invicly Learn (required for /learn accounts and plans) ----
# Neon Postgres connection string (project "invicly-learn", aws-us-east-1)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
# 32+ random characters; signs the login cookie. Changing it logs everyone out.
# Generate with: openssl rand -base64 32
LEARN_AUTH_SECRET=

# ---- Email (sign-up/reset codes and contact-form enquiries) ----
# Without these, codes are printed to the server log instead (fine for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Contact form ----
# Enquiries are emailed over the SMTP settings above by /api/contact. Defaults to inviclytech@gmail.com.
CONTACT_NOTIFY_EMAIL=

# ---- Search engine verification (optional) ----
# Values from Google Search Console / Bing Webmaster Tools; rendered as <meta> tags.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
