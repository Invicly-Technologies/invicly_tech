# MongoDB Atlas connection string (Database Access user, not your Atlas account login)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@inviclycluster0.up7cvqq.mongodb.net/invicly?appName=InviclyCluster0

# NextAuth (admin login)
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Candidate (careers) login — separate JWT secret, deliberately not shared with NextAuth
CANDIDATE_JWT_SECRET=replace-with-another-long-random-string

# Initial admin account (used only by scripts/seed.mjs to create the first admin login)
ADMIN_EMAIL=admin@invictechnologies.com
ADMIN_PASSWORD=change-me

# SMTP (Gmail) — used to email a notification when the contact form is submitted
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=inviclytech@gmail.com
SMTP_PASS=your-gmail-app-password
CONTACT_NOTIFY_EMAIL=inviclytech@gmail.com
